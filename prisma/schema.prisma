// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  // "native" keeps local dev working (Windows/macOS); "rhel-openssl-3.0.x" is
  // the query engine Vercel's Node.js runtime needs. Without it the deployed
  // app builds fine but throws "could not locate the Query Engine" at runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (runtime)
  directUrl = env("DIRECT_URL") // direct (migrations)
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Three levels. `super_admin` is `admin` plus the right to manage other
/// admins — promote a user, demote an admin, remove an admin account. A plain
/// `admin` may never act on another admin.
enum Role {
  user
  admin
  super_admin
}

/// How a member relates to the school. Required from every new account, and
/// collected retroactively from older ones through /complete-profile.
enum Affiliation {
  old_boy
  parent
  staff
  outsider
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  blocked
  expired
}

/// How a court's hours are sold (docs/ARCHITECTURE.md → "Exclusive vs shared").
///  - `exclusive`: one booking per hour — courts. Enforced by the unique key on
///    BookingSlot.
///  - `shared`: many bookings per hour — a gym, a pool — optionally capped by
///    `Court.capacity`.
enum BookingMode {
  exclusive
  shared
}

/// Where an admin has got to with a special request. Handled by hand — a
/// request never becomes a booking on its own.
enum SpecialRequestStatus {
  new
  contacted
  resolved
}

enum PaymentStatus {
  pending
  success
  failed
  cancelled
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Profile row mirroring a Supabase Auth user. `id` equals `auth.users.id`.
///
/// Every profile field is nullable because a profile row is created by a
/// database trigger the moment Supabase Auth makes the user, and an OAuth
/// (Google) sign-in supplies none of them. The app treats a row missing any of
/// phone / address / NIC / emergency contact / affiliation as an *incomplete*
/// profile and routes the user through /complete-profile — see
/// `profileIsComplete` in lib/auth.ts. Accounts that predate a field simply
/// arrive incomplete and are asked for it.
model User {
  id      String  @id @db.Uuid
  email   String  @unique
  name    String?
  phone   String?
  address String?
  /// Sri Lankan NIC, upper-cased. One per account. Format CHECK in the database
  /// (`User_nic_format`): 9 digits + V/X, or 12 digits.
  nic     String? @unique
  /// A phone number to ring in an emergency during a session. Not unique.
  emergencyContact String?

  affiliation Affiliation?

  role            Role             @default(user)
  createdAt       DateTime         @default(now())
  bookings        Booking[]
  specialRequests SpecialRequest[]

  /// Conduct notes written ABOUT this user. Admin-only, in every layer.
  ratings UserRating[] @relation("RatingTarget")
  /// Conduct notes this user wrote, as an admin.
  ratingsGiven UserRating[] @relation("RatingAuthor")
  /// Security staff logins this (super admin) user created.
  securityStaffCreated SecurityStaff[] @relation("SecurityStaffCreatedBy")
}

/// An admin's private conduct note about a user: 1–5 stars plus a required
/// reason. Strictly internal — the rated user must never see these, which is
/// enforced in the server actions AND by RLS (no policy grants a non-admin any
/// access, not even to rows naming them).
model UserRating {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  /// Cascade: notes about someone who no longer has an account are meaningless.
  user   User   @relation("RatingTarget", fields: [userId], references: [id], onDelete: Cascade)

  /// The admin who wrote it. Nullable + SET NULL so removing a staff account
  /// keeps the venue's conduct history intact — it just stops naming them.
  adminId String? @db.Uuid
  admin   User?   @relation("RatingAuthor", fields: [adminId], references: [id], onDelete: SetNull)

  rating    Int // 1..5, also CHECK-constrained in the database
  comment   String
  createdAt DateTime @default(now())

  // Composite: the only read is "this user's notes, most recent first".
  @@index([userId, createdAt])
  @@index([adminId])
}

/// A "Contact us" submission from the public site. Read-only for admins —
/// nothing is emailed yet, the admin panel is the inbox.
model ContactMessage {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String
  message   String
  createdAt DateTime  @default(now())
  /// Set when an admin marks the message as read; null means unread.
  readAt    DateTime?

  @@index([createdAt])
  @@index([readAt])
}

/// Category of court (Tennis, Cricket, ...). Drives the player-count dropdown.
model CourtType {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @unique
  playerOptions Int[] // e.g. [2, 4] for singles / doubles
  courts        Court[]
}

model Court {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  courtTypeId  String         @db.Uuid
  courtType    CourtType      @relation(fields: [courtTypeId], references: [id])
  description  String?
  /// Free-text list, e.g. "Floodlights, Changing rooms, Water" — shown as-is
  /// on the public court page. Optional; no separate amenity taxonomy.
  amenities    String?
  /// Court-specific rules for the public court page, one per line. Null/blank
  /// = the court type's standard set (standardRulesForType in lib/court-rules.ts).
  rules        String?
  images       String[] // Supabase Storage URLs (Unsplash placeholders for now)
  /// Short code used in booking references, e.g. "BAD" for Badminton — see
  /// lib/booking-reference.ts. Null on a court nobody has booked yet; the
  /// first reference generated for it derives one from the name and persists
  /// it here (`ensureCourtReferencePrefix`), so it only ever needs to be
  /// derived once per court.
  referencePrefix String?
  /// This court's colour everywhere it needs to be told apart at a glance —
  /// the /bookings grid, the admin Bookings table — as a `#rrggbb` hex. One
  /// of the 9 named swatches in `lib/court-colors.ts` (`COURT_COLOR_PALETTE`),
  /// though any valid hex is stored as-is. Always paired with the court's
  /// name wherever it is shown — see "Court colour" in ARCHITECTURE.md.
  color           String  @default("#0E7A34")
  /// Cannot change while the court holds today's or future hours (DB trigger
  /// `court_guard_booking_mode`), because BookingSlot.exclusive is derived from it.
  bookingMode  BookingMode    @default(exclusive)
  /// Shared facilities only: max people per hour (sum of playerCount). Null =
  /// unlimited. CHECK >= 1 in the database.
  capacity     Int?
  /// Position in every court list, lowest first (name breaks ties). Spaced in
  /// tens; createCourt appends after the current last. See COURT_DISPLAY_ORDER.
  displayOrder Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  slots        SlotTemplate[]
  bookings     Booking[]
  bookingSlots BookingSlot[]
  specialRequests SpecialRequest[]
  bookingSequences BookingSequence[]

  @@index([courtTypeId])
  @@index([displayOrder])
}

/// A signed-in user's manual request for a court — a time outside the listed
/// hours, a large group, an event. It does NOT reserve anything: no Booking or
/// BookingSlot is written, and an admin follows up by hand.
///
/// Name, email, phone and court name are snapshots taken at submission, so the
/// request still reads correctly if the account or court later changes or goes.
model SpecialRequest {
  id        String  @id @default(uuid()) @db.Uuid
  /// SET NULL: removing an account keeps the request (and its snapshot contact).
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// SET NULL: deleting a court must not be blocked by, or erase, requests for it.
  courtId   String? @db.Uuid
  court     Court?  @relation(fields: [courtId], references: [id], onDelete: SetNull)
  courtName String

  name  String?
  email String
  phone String?

  preferredDate DateTime @db.Date
  preferredTime DateTime @db.Time(6) // wall-clock, via lib/time.ts
  playerCount   Int
  message       String

  status    SpecialRequestStatus @default(new)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([courtId])
}

/// Per-court recurring schedule. A slot is a template, not a per-day row.
/// One template is exactly ONE bookable hour.
model SlotTemplate {
  id           String        @id @default(uuid()) @db.Uuid
  courtId      String        @db.Uuid
  court        Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 0..6 (Sun..Sat)
  startTime    DateTime      @db.Time(6) // time-of-day, e.g. 09:00
  endTime      DateTime      @db.Time(6) // time-of-day, e.g. 10:00
  price        Decimal       @db.Decimal(10, 2) // LKR
  isActive     Boolean       @default(true)
  bookingSlots BookingSlot[]

  @@index([courtId, dayOfWeek])
}

/// ONE reservation. May cover several consecutive hours on the same court and
/// date — the hours themselves are the `BookingSlot` children.
model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  courtId       String        @db.Uuid
  court         Court         @relation(fields: [courtId], references: [id])
  bookingDate   DateTime      @db.Date
  userId        String?       @db.Uuid // null only for legacy rows; blocks are owned by the admin
  user          User?         @relation(fields: [userId], references: [id])
  playerCount   Int
  durationHours Int           @default(1) // number of consecutive slots, min 1
  totalPrice    Decimal       @default(0) @db.Decimal(10, 2) // sum of the slots' prices, frozen
  /// Readable, stable code — e.g. "BAD-0915-003" (court prefix, MMDD, that
  /// court+date's Nth booking). Assigned ONCE in the same transaction as the
  /// row itself (lib/booking-reference.ts) and never changed afterward, even
  /// if earlier bookings on that court/date are later cancelled or deleted.
  /// Null only on rows written before this column existed.
  bookingReference String?    @unique
  status        BookingStatus @default(pending)
  holdExpiresAt DateTime? // expiry for a pending hold
  createdAt     DateTime      @default(now())
  /// Set when the OWNER removes an unpaid booking from their own list. The row
  /// stays: a booking is a record, and it may already have Payment attempts
  /// hanging off it. Only the user's account list hides it — admin views and
  /// every availability query are untouched.
  removedAt     DateTime?
  payments      Payment[]
  slots         BookingSlot[]

  @@index([courtId, bookingDate])
  @@index([userId])
  @@index([userId, removedAt])
  @@index([status])
  @@index([status, holdExpiresAt])
  // The admin views: /admin orders upcoming bookings by date with a status
  // filter, /admin/bookings sorts the whole table by date. Both scanned.
  @@index([bookingDate, status])
}

/// One row per reserved HOUR — this is the row the anti double-booking
/// constraint protects. A 3-hour booking owns three of these.
///
/// `courtId` and `bookingDate` are denormalised from the parent so the unique
/// constraint can be evaluated within a single row; they are always written in
/// the same transaction as the parent.
///
/// These rows exist only while the booking actually HOLDS the hours. Releasing
/// a booking (expiry, cancellation, unblock) deletes them, which is what frees
/// the hours for someone else — the unique index cannot look at the parent's
/// status.
model BookingSlot {
  id          String       @id @default(uuid()) @db.Uuid
  bookingId   String       @db.Uuid
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  slotId      String       @db.Uuid
  slot        SlotTemplate @relation(fields: [slotId], references: [id])
  courtId     String       @db.Uuid
  court       Court        @relation(fields: [courtId], references: [id])
  bookingDate DateTime     @db.Date
  price       Decimal      @db.Decimal(10, 2) // that hour's price, frozen at booking time
  /// DERIVED BY A DB TRIGGER from the court's bookingMode — never set it from
  /// the app (the trigger overwrites whatever is sent). TRUE for an exclusive
  /// court, NULL for a shared one.
  exclusive   Boolean?     @default(true)

  // Anti double-booking guarantee: one reservation per court + date + hour —
  // for EXCLUSIVE courts. Every exclusive row has exclusive = TRUE, so this is
  // exactly UNIQUE (courtId, bookingDate, slotId) for them. Shared rows carry
  // NULL, and NULLs never collide in a Postgres unique index, so a shared hour
  // takes many bookings (capacity is enforced in the booking service instead).
  @@unique([courtId, bookingDate, slotId, exclusive])
  @@index([bookingId])
  @@index([courtId, bookingDate])
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  bookingId  String        @db.Uuid
  booking    Booking       @relation(fields: [bookingId], references: [id])
  orderId    String        @unique // merchant order id sent to PayHere
  amount     Decimal       @db.Decimal(10, 2)
  currency   String        @default("LKR")
  status     PaymentStatus @default(pending)
  payhereRef String? // payment_id from PayHere
  createdAt  DateTime      @default(now())

  @@index([bookingId])
}

/// The counter behind `Booking.bookingReference`'s sequence number — one row
/// per court + date, incremented atomically (`INSERT ... ON CONFLICT DO
/// UPDATE ... RETURNING`, see lib/booking-reference.ts) inside the same
/// transaction that writes the `Booking`. The count only ever goes up: a
/// cancelled or deleted booking does not give its number back, which is what
/// keeps every reference stable and unique forever.
model BookingSequence {
  id          String   @id @default(uuid()) @db.Uuid
  courtId     String   @db.Uuid
  court       Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  bookingDate DateTime @db.Date
  lastSeq     Int      @default(0)

  @@unique([courtId, bookingDate])
}

/// A security guard's individual sign-in — NOT a Supabase Auth account.
/// Deliberately its own table rather than a `Role` value on `User`: that table
/// mirrors `auth.users` 1:1 (CLAUDE.md, docs/ARCHITECTURE.md → Auth & roles),
/// and a security login has no email, no password and no Supabase session —
/// only a username and a PIN, checked entirely server-side against this table
/// (lib/security-staff/). Keeping it separate means every existing admin/user
/// auth path is completely unaffected by this feature.
///
/// One row per person, for individual accountability — never a shared
/// username. A super admin creates, disables and removes these; see
/// docs/ARCHITECTURE.md → "Security staff".
model SecurityStaff {
  id             String    @id @default(uuid()) @db.Uuid
  /// Lower-cased at write time so lookups are case-insensitive without
  /// needing citext. Short, memorable — not an email.
  username       String    @unique
  /// scrypt hash, "<salt>:<hash>" hex — never the plain PIN. See lib/security-staff/pin.ts.
  pinHash        String
  /// A name/label for the admin panel — "Gate — night shift", "J. Perera".
  label          String?
  isActive       Boolean   @default(true)
  /// Reset to 0 on a successful login. Checked against SECURITY_PIN_MAX_ATTEMPTS.
  failedAttempts Int       @default(0)
  /// Set once failedAttempts reaches the limit; the account cannot log in
  /// again until this passes, however many more correct or incorrect PINs
  /// arrive in between.
  lockedUntil    DateTime?
  /// The super admin who created this login. SET NULL on removal — the
  /// account survives as a record, it just stops naming anyone (same pattern
  /// as UserRating.adminId).
  createdById    String?   @db.Uuid
  createdBy      User?     @relation("SecurityStaffCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  disabledAt     DateTime?
}
