# --- Supabase / Database ---
# Pooled connection (runtime). From Supabase: Project Settings > Database > Connection string (Transaction/pooled, port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (migrations). Same page, direct connection, port 5432.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # SERVER ONLY — never expose

# --- PayHere ---
NEXT_PUBLIC_PAYHERE_MERCHANT_ID="your-merchant-id"
PAYHERE_MERCHANT_SECRET="your-merchant-secret"      # SERVER ONLY — never expose
NEXT_PUBLIC_PAYHERE_MODE="sandbox"                  # sandbox | live
NEXT_PUBLIC_PAYHERE_JS="https://www.payhere.lk/lib/payhere.js"

# --- Email (Resend) ---
# From https://resend.com/api-keys. SERVER ONLY — never expose.
RESEND_API_KEY="re_your_api_key"
# Where Contact Us enquiries are delivered.
ADMIN_CONTACT_EMAIL="sports@school.lk"
# From address. The default below is Resend's shared test sender, which needs no
# DNS setup but only delivers to the email that owns the Resend account.
# Switch to an address on a verified domain before go-live.
CONTACT_FROM_EMAIL="Courtside <onboarding@resend.dev>"

# --- App ---
# Public URL in prod. Used for PayHere return/notify AND for the auth callback
# URLs (email confirmation, Google OAuth redirectTo). Must match one of the
# Redirect URLs configured in Supabase > Authentication > URL Configuration.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
